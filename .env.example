PUBLIC_URL=https://everything.YOUR-TAILNET.ts.net
ALLOWED_EMAIL=you@example.com
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
# Generate independent secrets with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-bytes
POSTGRES_PASSWORD=replace-with-independent-random-password
APP_DB_PASSWORD=replace-with-independent-random-password
HEALTH_DB_PASSWORD=replace-with-independent-random-password
# Keep the default: HTTPS is required outside local development.
COOKIE_SECURE=true
