PUBLIC_URL=https://monopol-ai.de
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-16-characters
# Generate independent secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-independent-random-password
APP_DB_PASSWORD=replace-with-independent-random-password
HEALTH_DB_PASSWORD=replace-with-independent-random-password
# Keep the default: HTTPS is required outside local development.
COOKIE_SECURE=true
# Optional agent: base URL including /v1, model supporting tool calls.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# The Compose API service mounts a persistent volume at /vault.
OBSIDIAN_VAULT_PATH=/vault
